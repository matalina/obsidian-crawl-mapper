{
	"name": "obsidian-crawl-mapper",
	"version": "0.1.0",
	"description": "Text-based crawl maps for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "tsx src/city/notation.test.ts && tsx src/pointcrawl/notation.test.ts && tsx src/text-mapper/themes/tailwind-colors.test.ts && node scripts/icon-packs.test.mjs",
		"test:vault": "npm run build && node scripts/copy-to-vault.mjs"
	},
	"keywords": [],
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"tsx": "^4.19.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/matalina/obsidian-crawl-mapper.git"
	}
}
